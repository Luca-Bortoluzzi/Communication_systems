clc;
clear;
close all;
n=63;
k=57;
r=n-k;
%% 1
c = dec2bin(1:2^r-1,r)' - '0'; %matrix 6x63
w = sum(c,1); % weight=1;
P_T= c(:, w >= 2); %6x57
H = [P_T, eye(r)]; % parity check matrix
P=P_T';
G = [eye(k), P]; %Generator Matrix
%% 2
p_an = logspace(-3,-1,100);
pW_an = 1 -(1-p_an).^n -n.*p_an.*(1-p_an).^(n-1); %Analytical Formula
%% 3
figure,plot(p_an,pW_an,'b'),axis('tight'),grid("on");
title('Analytical Performance curve'),xlabel('Bit Error Probability'),ylabel('Codeword Error Probability');


%% 4
p_sim = logspace(-3, -1, 8);
pW_sim = zeros(size(p_sim));
target_errors = 100;

twos = 2.^(r-1:-1:0); % Powers of 2
H_dec = twos * H;     % Valore decimale di ciascuna colonna di H (1 x 63)

for i = 1:length(p_sim)
    p = p_sim(i);
    current_errors = 0;
    totalWords = 0;

    while current_errors < target_errors
        % 1. Generazione messaggio e codeword
        messageBits = randi([0 1], 1, k);
        codeword = mod(messageBits * G, 2);

        % 2. Canale BSC: parola ricevuta
        receivedWord = mod(codeword + (rand(1, n) < p), 2);

        % 3. Calcolo sindrome in GF(2) e conversione in decimale
        syndrome_vec = mod(receivedWord * H', 2);
        syndrome = syndrome_vec * twos';

        % 4. Correzione cercando la colonna corrispondente in H_dec
        decodedWord = receivedWord;
        if syndrome > 0
            err_pos = find(H_dec == syndrome, 1);
            decodedWord(err_pos) = mod(decodedWord(err_pos) + 1, 2);
        end

        current_errors = current_errors + any(decodedWord ~= codeword);
        totalWords = totalWords + 1;
    end

    pW_sim(i) = current_errors / totalWords;
end
%% 5
figure,plot(p_sim,pW_sim,'b'),axis('tight'),grid("on");
xlabel('$$\widehat{Bit\ Error\ Probability}$$','Interpreter','latex'),ylabel('$$\widehat{Codeword\ Error\ Probability}$$','Interpreter','latex');
title('Simulated Performance Curve');

%% 6
figure,plot(p_an,pW_an,'b',p_sim,pW_sim,'g--'),legend('Analytical Curve','Simulated Curve'),axis('tight'),grid('on');
title('Performance curves'),xlabel('Bit Error Probability'),ylabel('Codeword Error Probability');
% The 

%% 7
%The C(63,57) binary Hamming code is a perfect code: the 2^57 is joint Hamming spheres of radius t = 1 
%each containing 2^6 vectors completely partition the entire ambient space
%Because every possible syndrome maps uniquely to an error pattern of weight <=1 and no
%received vector falls outside the decoding spheres, no decoding failures can ever occur
%Consequently, the bounded-distance decoder and the complete minimum-distance decoder
%are identical and yield the exact same codeword error probability over a BSC
